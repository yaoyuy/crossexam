# CrossExam 环境变量模板
# 复制为 .env 后填写。.env 已被 .gitignore 挡住，不会被提交。

# ── 模型服务（OpenAI 兼容协议）────────────────────────────────
# 任何 OpenAI 兼容端点都可以：DeepSeek / 通义千问 / 智谱 / OpenAI / 本地 Ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-替换成你自己的密钥
LLM_MODEL=deepseek-chat

# 思考模型（可选）：把指定阶段的调用交给会思考的模型，界面上就能看到「思考过程」分片。
# 不填不接思考模型，一切照旧。注意思考文本通常是英文，那是模型侧的行为，我们不翻译。
# CROSSEXAM_REASONING_MODEL=deepseek-reasoner
# 哪几个阶段用思考模型（逗号分隔）：extract / probe / answer / verdict / suggest。
# 默认只给 verdict：追问一轮要十几次调用，全交给思考模型会把一场面试从十几秒拉成几分钟。
# CROSSEXAM_REASONING_STAGES=verdict

# 同时上场的面试官数量上限（1-6）。这是上限，不是默认值：
# 默认面板本来就是 3 位，只有请求里用 ?panel= 点名更多面试官时才会被截断。
# 非法值（非整数、超出 1-6）当没设处理，不会悄悄把面板变成 1 位。
PANEL_SIZE=4

# ── 运行模式 ─────────────────────────────────────────────────
# live   = 真实调用模型
# replay = 离线回放已录制的响应（评委没有 Key 也能完整跑通全流程）
CROSSEXAM_MODE=replay

# 本地 SQLite 文件路径（留空则用 ./data/crossexam.db）
# CROSSEXAM_DB=./data/crossexam.db
