# 统一换行符：仓库内与检出后一律 LF。
# 理由：评分硬要求「10 分钟极速复现」，CRLF 随平台漂移会让 diff 整文件变色，
# 更会让回放 fixture 的 sha256 对不上——而「回放可复现」正是本项目的核心卖点之一。
* text=auto eol=lf

# 二进制文件不做文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.zip binary

# 生成物：diff 噪音大，语言统计里标成 generated
package-lock.json linguist-generated=true
docs/prompt-chain/** linguist-generated=true
fixtures/llm/** linguist-generated=true
