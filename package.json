{
  "name": "crossexam",
  "version": "0.1.0",
  "private": true,
  "description": "CrossExam 质询室 — 多 Agent 对抗式面试沙盘",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @crossexam/server",
    "dev:web": "npm run dev -w @crossexam/web",
    "build": "npm run build --workspaces --if-present",
    "start": "node packages/server/src/bin/serve.ts",
    "preview": "npm run build && npm run start",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run smoke && npm run build",
    "smoke": "node tools/smoke/smoke.mjs",
    "shots": "node tools/ui-shots/shots.mjs",
    "e2e:ui": "node tools/ui-e2e/e2e.mjs",
    "repro": "node tools/repro/repro-check.mjs",
    "export:prompt": "node tools/dsh-export/bin/dsh-export.mjs",
    "seed:demo": "node packages/server/src/bin/seed-demo.ts",
    "docs:pdf": "node tools/docs/build-doc.mjs",
    "docs:html": "node tools/docs/build-doc.mjs --html-only"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}