# =============================================================================
# .gitignore  ·  通用安全全集模板
# -----------------------------------------------------------------------------
# 用途：任何新项目开 git 之前，把这个文件复制成项目根目录的 .gitignore
# 结构：三层防护 —— 🔑 密钥本体 / 🚪 网关令牌 / 🔐 夹带密钥的产物
# 原则：宁可多挡，不可漏挡。被多挡的文件不会丢，只是不进仓库。
#
# 用法：整段复制到项目根目录，命名为 .gitignore（前面有个点，是隐藏文件）
# 维护：项目里用不到的整段（比如 Java 段、.NET 段）可以整段删掉，不影响其他
# =============================================================================


# #############################################################################
# 🔑 第一层：密钥本体 —— API Key / 令牌 / 密码 / 私钥
# #############################################################################
# 这一层是底线。只要命中这里，git 根本不会把文件纳入版本控制，
# 也就谈不上"不小心提交"。

# --- .env 全家族 -------------------------------------------------------------
# .env / .env.local / .env.production / .env.dev.local ……
# 注意：单独放行 .env.example 作为公开模板，但那个文件里只能有假值。
.env
.env.*
!.env.example
!.env.template
!.env.sample

# --- 本地覆盖配置（个人机器专用，绝不进仓库）---------------------------------
config.local.*
config.*.local
*.local.yml
*.local.yaml
*.local.json
local_settings.py
local_config.py
settings.local.php

# --- 证书与私钥 --------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.ppk
*.ovpn
*.kdbx

# --- 凭据类文件 --------------------------------------------------------------
secrets.*
*secret*
credentials.*
*credential*
*token*.json
*token*.txt
*secret*.txt
*password*.txt
passwords.txt
*.pwd
*apikey*
*api_key*
.netrc
_netrc
.htpasswd
.npmrc
.pypirc
.gem/credentials
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*

# --- 云 / CI 的本地凭据目录 --------------------------------------------------
.aws/
.azure/
.gcloud/
.kube/
.docker/config.json
.terraform/
*.tfstate
*.tfstate.*
*.tfvars


# #############################################################################
# 🚪 第二层：网关令牌 —— Bearer JWT / Session / Cookie
# #############################################################################
# 背景：项目调 API key 之前要先过网关令牌校验，令牌是 Bearer JWT，
# 由 .env 里的 JWT_SECRET_KEY 签发。密钥已在第一层挡住，
# 这里挡的是运行期产生、可能落到磁盘上的令牌本身。

# --- 令牌与会话落盘物 --------------------------------------------------------
*.token
*.jwt
*.session
*.cookies
cookies.txt
session.json
sessions/
storage/
*.storageState.json
auth.json

# --- 抓包 / 请求录制（几乎一定带 Authorization 头）---------------------------
*.har
*.pcap
*.pcapng
*.chls

# --- 接口调试工具的本地环境（常存着 Bearer token）----------------------------
*.postman_environment.json
*.postman_globals.json
*.rest
*.http
.http/


# #############################################################################
# 🔐 第三层：夹带密钥的产物 —— 数据库 / 日志 / 备份 / 导出
# #############################################################################
# 这一层最容易被忽略：日志里可能打印出完整请求头，
# 数据库里可能有用户密码哈希，导出的备份里可能有整份 .env。

# --- 数据库与向量库 ----------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.mdb
*.dump
*.sql.gz
*.sql.bz2
/data/*.db
/vector_index/
/chroma_db/
/.milvus/

# --- 日志（可能含请求头、异常堆栈里的配置值）---------------------------------
logs/
*.log
*.log.*
*.out
*.err
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 备份与临时文件 ----------------------------------------------------------
*.bak
*.bak-*
*.backup
*.old
*.orig
*.rej
*.swp
*.swo
*~
*.tmp
.tmp/
*.temp
*.crdownload
*.part
*.partial

# --- 导出物（Excel/CSV 导出常含用户数据）-------------------------------------
/exports/
/export/
*.export.csv
*_export.*


# #############################################################################
# 依赖与环境 —— 体积原因忽略，与安全无关
# #############################################################################

# --- Python ------------------------------------------------------------------
.venv/
venv/
*.venv
env/
ENV/
python3*/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.so
.Python
pip-log.txt
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
site/

# --- Node / 前端 -------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/cache
.yarn/unplugged
bower_components/
dist/
build/
.next/
.nuxt/
.output/
.vite/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# --- Java / Maven / Gradle ---------------------------------------------------
target/
out/
.gradle/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear

# --- .NET / C# ---------------------------------------------------------------
bin/
obj/
*.user
*.suo
packages/
*.nupkg

# --- Go / Rust ---------------------------------------------------------------
/vendor/
Cargo.lock
target/

# --- 通用构建产物 ------------------------------------------------------------
*.o
*.obj
*.exe
*.dll
*.pdb
*.lib


# #############################################################################
# IDE 与操作系统
# #############################################################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

.idea/
# 注意：必须写 .vscode/* 而不是 .vscode/
# 因为整目录被排除后，下面的 ! 例外规则会失效（git 不允许从被忽略的目录里捞回文件）
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace
*.sublime-project
*.sublime-workspace


# #############################################################################
# 项目专属区 —— 按项目情况自己加
# #############################################################################
# 常见写法示例（用不到就删掉）：
# /data/documents/
# /data/chroma_db/
# /deployments/volumes/
# /qqica.db
# 答辩PPT/
# paper-output/
# .codex-ppt-build/
